# Tiltfile for developing the OpenEverest Metrics plugin.
#
# Installs the released OpenEverest v2 core, the Prometheus Operator with a
# Prometheus, and the Milvus provider with a small Prometheus-enabled instance,
# then builds this plugin's frontend bundle + backend image and deploys the
# plugin chart with rebuild on change.
#
# Usage:
#   make dev-up            # create the k3d cluster and run `tilt up`
#   tilt up -f dev/Tiltfile
#
# See dev/.env.example for configuration. Each dependency can be switched off
# to reuse one you already run.

# ===========================
# Utilities
# ===========================
def str2bool(v):
    return str(v).lower() in ("yes", "true", "t", "1")

# ===========================
# Settings
# ===========================
# The core and kube-prometheus-stack charts install CRDs and several workloads;
# 30s (the default) is not enough on a cold image cache.
update_settings(k8s_upsert_timeout_secs=300)

# ===========================
# Configuration (.env)
# ===========================
load('ext://dotenv', 'dotenv')
local_env_file = '{0}/.env'.format(config.main_dir)
if os.path.exists(local_env_file):
    print('Loading local .env file={0}'.format(local_env_file))
    dotenv(fn=local_env_file)

install_openeverest = str2bool(os.getenv('INSTALL_OPENEVEREST', 'true'))
openeverest_version = os.getenv('OPENEVEREST_VERSION', '')
openeverest_helm_repo = os.getenv(
    'OPENEVEREST_HELM_REPO', 'https://openeverest.github.io/helm-charts/')

install_prometheus = str2bool(os.getenv('INSTALL_PROMETHEUS', 'true'))
prometheus_namespace = os.getenv('PROMETHEUS_NAMESPACE', 'monitoring')

install_milvus_provider = str2bool(os.getenv('INSTALL_MILVUS_PROVIDER', 'true'))
milvus_provider_chart = os.getenv('MILVUS_PROVIDER_CHART', '') or \
    'oci://ghcr.io/openeverest/charts/provider-milvus'
milvus_provider_version = os.getenv('MILVUS_PROVIDER_VERSION', '')
milvus_provider_image = os.getenv('MILVUS_PROVIDER_IMAGE', '')
create_demo_instance = str2bool(os.getenv('CREATE_DEMO_INSTANCE', 'true'))

everest_namespace = os.getenv('EVEREST_NAMESPACE', 'everest-system')
plugin_namespace = os.getenv('PLUGIN_NAMESPACE', 'everest-system')

# Installs dependencies only when node_modules is missing so `npm install`
# doesn't touch package-lock.json on every rebuild (which would loop this resource).
plugin_build_cmd = os.getenv(
    'PLUGIN_BUILD_CMD',
    '[ -d node_modules ] || npm install; npm run build')
everest_api_url = os.getenv('EVEREST_API_URL', '')
# `or`, because dev/.env.example sets the variable empty.
prometheus_url = os.getenv('PROMETHEUS_URL', '') or \
    'http://kube-prometheus-stack-prometheus.{0}.svc:9090'.format(prometheus_namespace)
ui_admin_password = os.getenv('UI_ADMIN_PASSWORD', 'admin')

# ===========================
# Paths
# ===========================
plugin_dir = os.path.realpath('{0}/..'.format(config.main_dir))
chart_dir = '{0}/charts/plugin-metrics'.format(plugin_dir)

# ===========================
# External cluster / registry
# ===========================
k8s_context = os.getenv('K8S_CONTEXT', '')
if k8s_context:
    allow_k8s_contexts(k8s_context)

docker_registry_url = os.getenv('DOCKER_REGISTRY_URL', '')
if docker_registry_url:
    default_registry(docker_registry_url)

# Remote clusters may differ from this machine's architecture, e.g. linux/amd64.
docker_platform = os.getenv('DOCKER_PLATFORM', '')

load('ext://helm_resource', 'helm_resource', 'helm_repo')

# ===========================
# OpenEverest core (released)
# ===========================
if install_openeverest:
    helm_repo(
        'openeverest-repo',
        openeverest_helm_repo,
        labels=['openeverest'],
    )

    core_flags = [
        '--create-namespace',
        '--set', 'server.initialAdminPassword={0}'.format(ui_admin_password),
        '--set', 'telemetry=false',
        '--set', 'upgrade.preflightChecks=false',
        '--set', 'kube-state-metrics.enabled=false',
        '--set', 'monitoring.replicaCount=0',
        '--set', 'createMonitoringResources=false',
    ]
    if openeverest_version:
        core_flags = core_flags + ['--version', openeverest_version]

    helm_resource(
        'openeverest',
        'openeverest-repo/openeverest',
        release_name='everest',
        namespace=everest_namespace,
        flags=core_flags,
        port_forwards=[port_forward(8080, 8080, 'Everest UI/API')],
        resource_deps=['openeverest-repo'],
        labels=['openeverest'],
    )

# ===========================
# Prometheus Operator + Prometheus
# ===========================
if install_prometheus:
    helm_repo(
        'prometheus-community',
        'https://prometheus-community.github.io/helm-charts',
        labels=['monitoring'],
    )

    helm_resource(
        'kube-prometheus-stack',
        'prometheus-community/kube-prometheus-stack',
        release_name='kube-prometheus-stack',
        namespace=prometheus_namespace,
        flags=[
            '--create-namespace',
            '--set', 'grafana.enabled=false',
            '--set', 'alertmanager.enabled=false',
            '--set', 'nodeExporter.enabled=false',
            '--set', 'kubeStateMetrics.enabled=false',
            '--set', 'prometheus.prometheusSpec.retention=1d',
            # Scrape every PodMonitor, not only ones labelled with this release.
            '--set', 'prometheus.prometheusSpec.podMonitorSelectorNilUsesHelmValues=false',
        ],
        port_forwards=[port_forward(9090, 9090, 'Prometheus')],
        resource_deps=['prometheus-community'],
        labels=['monitoring'],
    )

# ===========================
# Milvus provider + demo instance
# ===========================
if install_milvus_provider:
    provider_flags = []
    if milvus_provider_version:
        provider_flags = ['--version', milvus_provider_version]
    if milvus_provider_image:
        repository, tag = milvus_provider_image.rsplit(':', 1)
        provider_flags = provider_flags + [
            '--set', 'image.repository={0}'.format(repository),
            '--set', 'image.tag={0}'.format(tag),
        ]

    provider_deps = []
    if install_openeverest:
        provider_deps.append('openeverest')
    # The provider only creates PodMonitors when their CRD exists.
    if install_prometheus:
        provider_deps.append('kube-prometheus-stack')

    helm_resource(
        'provider-milvus',
        milvus_provider_chart,
        namespace=everest_namespace,
        flags=provider_flags,
        resource_deps=provider_deps,
        labels=['milvus'],
    )

    if create_demo_instance:
        k8s_yaml('{0}/dev/demo-instance.yaml'.format(plugin_dir))
        k8s_resource(
            new_name='milvus-demo',
            objects=['milvus-demo:namespace', 'milvus-demo:instance'],
            resource_deps=['provider-milvus'],
            labels=['milvus'],
        )

# ===========================
# Plugin: frontend bundle
# ===========================
# The backend embeds dist/main.js (go:embed), so the bundle must exist before
# the image is built.
local_resource(
    'plugin-metrics-frontend',
    'cd {0} && {1}'.format(plugin_dir, plugin_build_cmd),
    deps=[
        '{0}/src'.format(plugin_dir),
        '{0}/package.json'.format(plugin_dir),
        '{0}/vite.config.ts'.format(plugin_dir),
        '{0}/tsconfig.json'.format(plugin_dir),
    ],
    labels=['plugin-metrics'],
)

# ===========================
# Plugin: backend image
# ===========================
plugin_image = 'ghcr.io/openeverest/plugin-metrics:tilt-dev'
build_args = {}
if docker_platform:
    build_args['platform'] = docker_platform
docker_build(
    plugin_image,
    context=plugin_dir,
    dockerfile='{0}/Dockerfile'.format(plugin_dir),
    only=[
        'backend',
        'dist/main.js',
    ],
    **build_args
)

# ===========================
# Plugin: Helm chart
# ===========================
plugin_flags = [
    '--create-namespace',
    '--set', 'image.pullPolicy=IfNotPresent',
    '--set', 'prometheus.url={0}'.format(prometheus_url),
]
if everest_api_url:
    plugin_flags = plugin_flags + ['--set', 'everestAPIURL={0}'.format(everest_api_url)]

plugin_resource_deps = ['plugin-metrics-frontend']
if install_openeverest:
    plugin_resource_deps = plugin_resource_deps + ['openeverest']

helm_resource(
    'plugin-metrics',
    chart_dir,
    namespace=plugin_namespace,
    flags=plugin_flags,
    image_deps=[plugin_image],
    image_keys=[('image.repository', 'image.tag')],
    resource_deps=plugin_resource_deps,
    labels=['plugin-metrics'],
)
