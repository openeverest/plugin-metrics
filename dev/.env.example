# Environment configuration for the plugin-metrics dev Tiltfile (dev/Tiltfile).
#
# Copy this file to dev/.env and adjust as needed:
#   cp dev/.env.example dev/.env

# -- OpenEverest core --------------------------------------------------------

# Install the released OpenEverest v2 core (server + controller + CRDs). Set to
# false if you run the core from source in a separate Tilt instance.
INSTALL_OPENEVEREST=true

# OpenEverest core chart version. While v2 is in pre-release, Helm's "latest"
# skips pre-releases, so set it explicitly, e.g. OPENEVEREST_VERSION=2.0.0-dev.4
OPENEVEREST_VERSION=

# Helm repository that hosts the OpenEverest core chart.
OPENEVEREST_HELM_REPO=https://openeverest.github.io/helm-charts/

# Namespace the OpenEverest core is installed into.
EVEREST_NAMESPACE=everest-system

# Initial admin password for the Everest UI/API.
UI_ADMIN_PASSWORD=admin

# -- Monitoring --------------------------------------------------------------

# Install kube-prometheus-stack (Prometheus Operator + one Prometheus that
# scrapes every PodMonitor). Set to false to use your own.
INSTALL_PROMETHEUS=true
PROMETHEUS_NAMESPACE=monitoring

# Prometheus HTTP API the plugin queries. Defaults to the one installed above.
PROMETHEUS_URL=

# -- Milvus ------------------------------------------------------------------

# Install the released Milvus provider and a small standalone instance with
# Prometheus monitoring enabled, so the Metrics tab has data. The provider needs
# the Monitoring -> Prometheus setting (openeverest/provider-milvus#11).
INSTALL_MILVUS_PROVIDER=true
# Provider chart version. Empty means latest.
MILVUS_PROVIDER_VERSION=
# Chart to install instead of the released one, e.g. a local checkout
# (run `make helm-deps` there first): ../provider-milvus/charts/provider-milvus
MILVUS_PROVIDER_CHART=
# Provider image override (repository:tag), e.g. a branch build.
MILVUS_PROVIDER_IMAGE=
CREATE_DEMO_INSTANCE=true

# -- Plugin ------------------------------------------------------------------

# Namespace the plugin Deployment/Service are installed into. The Plugin CR
# itself is cluster-scoped; its serviceRef points at this namespace.
PLUGIN_NAMESPACE=everest-system

# Command that builds the ESM frontend bundle into dist/main.js.
PLUGIN_BUILD_CMD=[ -d node_modules ] || npm install; npm run build

# Override the Everest API URL the backend calls. Leave empty to use the chart
# default (http://everest.everest-system.svc.cluster.local:8080).
EVEREST_API_URL=

# -- Cluster / registry (optional) -------------------------------------------

# Restrict Tilt to a specific Kubernetes context (recommended).
# K8S_CONTEXT=k3d-plugin-metrics-test

# Push images to a specific registry (defaults to the cluster's local registry).
# DOCKER_REGISTRY_URL=

# Build for the cluster's architecture when it differs from this machine's.
# DOCKER_PLATFORM=linux/amd64
